{
  "version": 1,
  "environment": "qab",
  "compartment_id": "ocid1.compartment.oc1..replace-me",
  "artifact_root": "oci://synthetic-data@namespace/pipeline-runs",
  "manifest_root": "oci://synthetic-data@namespace/pipeline-manifests",
  "genai": {
    "endpoint_id": "ocid1.generativeaiendpoint.oc1..replace-me",
    "compartment_id": "ocid1.compartment.oc1..replace-genai-compartment",
    "region": "sa-saopaulo-1",
    "max_concurrency": 4
  },
  "applications": {
    "engorda_plan": "ocid1.dataflowapplication.oc1..replace-engorda-plan",
    "engorda_materialize": "ocid1.dataflowapplication.oc1..replace-engorda-materialize",
    "validate": "ocid1.dataflowapplication.oc1..replace-validator",
    "load": "ocid1.dataflowapplication.oc1..replace-loader"
  },
  "reservations": {
    "lease_uri": "oci://synthetic-data@namespace/pipeline-control/qab/lease.json",
    "ledger_uri": "oci://synthetic-data@namespace/pipeline-control/qab/reservations.json"
  },
  "load": {
    "lease_uri": "oci://synthetic-data@namespace/pipeline-control/qab/load-lease.json",
    "claim_root": "oci://synthetic-data@namespace/pipeline-control/load-claims",
    "target_schema": "CETIP",
    "lease_ttl_seconds": 300
  },
  "products": {
    "cdb_simplificado": {"capabilities": ["engorda", "validate", "load"]},
    "cdb_resgate": {"capabilities": ["engorda", "validate", "load"]},
    "cdb_escalonamento": {"capabilities": ["engorda", "validate", "load"]},
    "rdb_inclusao": {"capabilities": ["engorda", "validate", "load"]},
    "rdb_resgate": {"capabilities": ["engorda", "validate", "load"]},
    "lci": {
      "capabilities": ["engorda", "validate", "load"],
      "engorda": {"n_instrumentos": 50000, "fator_k": 2}
    },
    "lca": {
      "capabilities": ["engorda", "validate", "load"],
      "engorda": {"n_instrumentos": 50000, "fator_k": 2}
    },
    "ccb_pppre": {"capabilities": ["engorda", "validate", "load"]},
    "ccb_pfpre": {"capabilities": ["engorda", "validate", "load"]},
    "ccb_pgrpre": {"capabilities": ["engorda", "validate", "load"]},
    "ccb_favcp": {"capabilities": ["engorda", "validate", "load"]},
    "ccb_fapre": {"capabilities": ["engorda", "validate", "load"]},
    "gravame": {"capabilities": ["engorda", "validate", "load"]},
    "lastro": {"capabilities": ["validate", "load"]},
    "direito_creditorio": {"capabilities": ["validate", "load"]}
  },
  "stage_defaults": {
    "engorda": {
      "n_instrumentos": 100,
      "fator_k": 1,
      "seed": 42,
      "no_oracle": false,
      "genai_policy": "oci://synthetic-data@namespace/contracts/genai-policy.json",
      "specs": "oci://synthetic-data@namespace/contracts/specs.json",
      "query_num_if_sql": "oci://synthetic-data@namespace/contracts/queries_produtos.sql"
    },
    "validate": {
      "fail_severity": "error",
      "validate_against": "union",
      "no_oracle": false
    },
    "load": {
      "num_partitions": 256,
      "batch_size": 10000
    }
  }
}
