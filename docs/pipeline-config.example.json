    "lca": {
      "capabilities": ["engorda", "validate"],
      "engorda": {"n_instrumentos": 50000, "fator_k": 2}
    },
    "ccb_pppre": {"capabilities": ["engorda", "validate"]},
    "ccb_pfpre": {"capabilities": ["engorda", "validate"]},
    "ccb_pgrpre": {"capabilities": ["engorda", "validate"]},
    "ccb_favcp": {"capabilities": ["engorda", "validate"]},
    "ccb_fapre": {"capabilities": ["engorda", "validate"]},
    "gravame": {"capabilities": ["validate"]},
    "lastro": {"capabilities": ["validate"]},
    "direito_creditorio": {"capabilities": ["validate"]}
  },
  "stage_defaults": {
    "engorda": {
      "n_instrumentos": 100,
      "fator_k": 1,
      "seed": 42,
      "specs": "oci://synthetic-data@namespace/contracts/specs.json",
      "query_num_if_sql": "oci://synthetic-data@namespace/contracts/queries_produtos.sql"
    },
    "validate": {
      "fail_severity": "error",
      "validate_against": "union"
    }
  }
