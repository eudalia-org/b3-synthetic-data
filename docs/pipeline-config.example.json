  },
  "products": {
    "cdb_simplificado": {"capabilities": ["engorda", "validate"]},
    "cdb_resgate": {"capabilities": ["engorda", "validate"]},
    "cdb_escalonamento": {"capabilities": ["engorda", "validate"]},
    "rdb_inclusao": {"capabilities": ["engorda", "validate"]},
    "rdb_resgate": {"capabilities": ["engorda", "validate"]},
    "lci": {
